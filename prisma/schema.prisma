generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Student {
  id          String    @id @default(cuid())
  studentCode String    @unique
  createdAt   DateTime  @default(now())
  sessions    Session[]
}

model Session {
  id              String        @id @default(cuid())
  studentId       String
  location        String
  situation       String
  character       String
  missionText     String
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  totalScore      Int           @default(0)
  finalConfidence Float?
  turnCount       Int           @default(0)
  student         Student       @relation(fields: [studentId], references: [id])
  turns           SessionTurn[]
  badges          SessionBadge[]

  @@index([studentId])
  @@index([completedAt])
}

model SessionTurn {
  id               String   @id @default(cuid())
  sessionId        String
  turnNumber       Int
  studentMessage   String
  characterReply   String
  analyticsJson    String   // JSON blob stored as text for SQLite compatibility
  pointsEarned     Int      @default(0)
  characterMood    String   @default("😊")
  wordCount        Int      @default(0)
  confidenceScore  Float    @default(0)
  struggleDetected Boolean  @default(false)
  createdAt        DateTime @default(now())
  session          Session  @relation(fields: [sessionId], references: [id])

  @@index([sessionId, turnNumber])
}

model SessionBadge {
  id        String   @id @default(cuid())
  sessionId String
  badgeName String
  awardedAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}
